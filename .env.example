# copy to .env and edit. PROVIDER picks the adapter: ollama | gemini | openai
PROVIDER=ollama

# ---- ollama (local) ----
OLLAMA_URL=http://localhost:11434
# leave empty to auto-pick the first vision-capable installed model
OLLAMA_MODEL=
# screen needs a vision model: ollama pull gemma3:4b

# ---- gemini (screen + audio in one call) ----
# PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ---- deepseek (OpenAI-compatible; deepseek-flash takes images) ----
# PROVIDER=openai
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=deepseek-flash
# OPENAI_VISION=true
# thinking is ON by default (~10s extra per reply); this disables it:
# OPENAI_EXTRA_BODY={"thinking":{"type":"disabled"}}

# ---- any other OpenAI-compatible endpoint (OpenRouter, Groq, LM Studio, vLLM...) ----
# PROVIDER=openai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=google/gemini-2.5-flash
# OPENAI_VISION=false   # for text-only models

# Optional speech-to-text for providers without audio input (Ollama, DeepSeek):
# any OpenAI-compatible /audio/transcriptions endpoint. Local no-key option:
# the whisper/ folder in this repo (see README "Local whisper server").
# Gemini ignores this and takes the WAV directly.
# TRANSCRIBE_URL=http://localhost:8000/v1/audio/transcriptions
# TRANSCRIBE_KEY=
# TRANSCRIBE_MODEL=whisper-1

# 0 = manual only: answer only when you click "What to say" or press the ask hotkey
# (the overlay's Auto switch sets this for the session; this value is the startup default)
INTERVAL_MS=0
# abort when the provider sends nothing for this many ms (connect or mid-stream); raise for slow local models
REQUEST_TIMEOUT_MS=60000
# past exchanges kept as context so replies stay on topic (session memory); 0 disables
HISTORY_CHUNKS=8
# the microphone is tapped too (best-effort; no mic = loopback only) so answers know what you
# actually said; with a non-Gemini provider the mic audio is transcribed via TRANSCRIBE_URL
# your resume/context text, sent with every ask; edit it via the Context button in the overlay
PROFILE_FILE=profile.txt
# keep the overlay out of screen shares/recordings (Windows WDA_EXCLUDEFROMCAPTURE); false to disable
HIDE_FROM_CAPTURE=true
SCREENSHOT_MAX_WIDTH=1280
HOTKEY_TOGGLE=CommandOrControl+\
HOTKEY_ASK=CommandOrControl+Enter
# SYSTEM_PROMPT=
